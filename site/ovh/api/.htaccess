# Amane — dossier api/ de l'hébergement OVH.
#
# Seul lead.php doit répondre au web. Le dossier _lib/ contient le reste du
# code : aucun accès HTTP direct, quelle que soit l'adresse demandée.
#
# Volontairement sans mod_rewrite : des règles de réécriture ici remplaceraient,
# pour tout le dossier api/, celles du .htaccess de la racine (dont celle qui
# fait répondre /api/lead par lead.php).

# Apache 2.4 et suivants
<IfModule mod_authz_core.c>
  <If "%{REQUEST_URI} =~ m#(^|/)_lib(/|$)#">
    Require all denied
  </If>
</IfModule>

# Repli pour Apache 2.2
<IfModule !mod_authz_core.c>
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "(^|/)_lib(/|$)" amane_lib_interdit
  </IfModule>
  Order allow,deny
  Allow from all
  Deny from env=amane_lib_interdit
</IfModule>
