# Variables d'environnement de la fonction /api/lead (formulaire de demande).
# Copiez ce fichier en « .env.local » pour le développement, et saisissez les
# mêmes noms dans Vercel (Project → Settings → Environment Variables).
# Ne mettez jamais de vraie valeur dans ce fichier : il est versionné.

# Clé de l'API transactionnelle Brevo (Brevo → Paramètres → Clés SMTP et API).
# Obligatoire. Sans elle, le formulaire répond 503 « email_off ».
BREVO_API_KEY=

# Adresse de l'équipe qui reçoit chaque demande.
# Obligatoire. Plusieurs adresses possibles, séparées par des virgules.
LEAD_TO_EMAIL=

# Adresse d'expédition des deux e-mails (demande et accusé de réception).
# Obligatoire. Elle doit être un expéditeur validé dans Brevo, sur un domaine
# authentifié (SPF, DKIM). Si le client répond à l'accusé de réception, sa
# réponse arrive sur cette adresse : choisissez une boîte qui est relevée.
LEAD_FROM_EMAIL=

# Nom d'expéditeur affiché dans la boîte de réception.
# Facultatif. Par défaut : Amane
LEAD_FROM_NAME=

# Origines supplémentaires autorisées à appeler /api/lead, séparées par des virgules.
# Facultatif. Par défaut, seul le domaine qui sert le site est accepté.
# Utile si le site est servi depuis un autre domaine que l'API (aperçu, serveur
# de développement Vite…). Chaque entrée est une origine complète
# (https://www.exemple.fr) ou un hôte seul (www.exemple.fr).
ALLOWED_ORIGINS=

# ───── Variables lues au moment du build (Vercel → Environment Variables) ─────

# Adresse publique du site, sans barre finale. Par défaut : https://amane.paris
# Sert aux balises canoniques, hreflang, au plan du site et à robots.txt.
# À ne renseigner que pour tester avec une autre adresse.
SITE_URL=

# Numéro WhatsApp affiché à côté du formulaire, format international, chiffres seulement.
# Facultatif. Vide = pas de lien WhatsApp.
VITE_WHATSAPP_NUMBER=

# Adresse e-mail publique affichée à côté du formulaire.
# Facultatif. Vide = pas de lien e-mail.
VITE_CONTACT_EMAIL=
