{
  "name": "amane-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Amane — site public (React + Vite, pages pré-rendues en 4 langues)",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "apercu": "APERCU=1 vite build --base ./ --outDir dist-apercu && node scripts/apercu.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/api/*.test.js"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.0.0",
    "@fontsource/bodoni-moda": "^5.0.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.0.0",
    "@fontsource/jost": "^5.0.0",
    "lenis": "^1.1.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
